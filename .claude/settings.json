{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright *)",
      "Bash(uv run python -m scripts.check_traceability *)",
      "Bash(uv run python -m scripts.check_cost_guardrails *)",
      "Bash(uv run python -m evals.run *)",
      "Bash(uv lock *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(docker compose ps *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(uv add *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh pr create *)",
      "Bash(terraform *)",
      "Bash(gcloud *)",
      "Edit(/infra/**)",
      "Edit(/.github/**)",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)"
    ],
    "deny": [
      "Edit(/bq-model/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gcloud run services delete *)",
      "Bash(terraform destroy *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block_secrets.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format_python.py\""
          }
        ]
      }
    ]
  }
}
